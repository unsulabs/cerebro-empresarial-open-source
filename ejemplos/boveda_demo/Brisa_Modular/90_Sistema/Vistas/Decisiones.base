filters:
  and:
    - 'file.ext == "md"'
    - not:
        - 'file.inFolder("90_Sistema/Plantillas")'
    - or:
        - 'tipo == "decision"'
views:
  - type: table
    name: "Decisiones"
    order:
      - file.name
      - estado_editorial
      - vigencia
      - fecha_efectiva
      - fuentes
