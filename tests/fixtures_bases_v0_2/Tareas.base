filters:
  and:
  - tipo == "tarea"
views:
- type: table
  name: Tabla
  order:
  - file.name
  - estado_tarea
  - responsable
  - fecha_programada
  - fecha_limite
- type: kanban
  name: Tablero
  groupBy:
    property: note.estado_tarea
    direction: ASC
  order:
  - file.name
  - estado_tarea
  - responsable
  - fecha_programada
