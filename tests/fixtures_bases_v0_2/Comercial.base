filters:
  or:
  - tipo == "propuesta_comercial"
  - tipo == "cliente_cuenta"
  - tipo == "acuerdo"
views:
- type: table
  name: Tabla
  order:
  - file.name
  - tipo
  - estado_editorial
  - vigencia
  - estado_comercial
  - fuentes
- type: kanban
  name: Tablero
  groupBy:
    property: note.tipo
    direction: ASC
  order:
  - file.name
  - tipo
  - estado_editorial
  - vigencia
