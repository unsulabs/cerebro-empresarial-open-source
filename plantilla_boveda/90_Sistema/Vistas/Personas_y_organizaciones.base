filters:
  and:
    - 'file.ext == "md"'
    - not:
        - 'file.inFolder("90_Sistema/Plantillas")'
    - or:
        - 'tipo == "persona"'
        - 'tipo == "organizacion"'
        - 'tipo == "proveedor"'
views:
- type: table
  name: Tabla
  order:
  - file.name
  - tipo
  - estado_editorial
  - fuentes
- type: cards
  name: Tarjetas
  order:
  - file.name
  - tipo
  - estado_editorial
